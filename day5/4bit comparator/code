module comparator_4bit(
    input [3:0] A,
    input [3:0] B,
    output A_gt_B,
    output A_lt_B,
    output A_eq_B
);
assign A_gt_B = (A > B);
assign A_lt_B = (A < B);
assign A_eq_B = (A == B);
endmodule

//testbench
`timescale 1ns/1ps
module comparator_4bit_tb;
reg [3:0] A;
reg [3:0] B;
wire A_gt_B;
wire A_lt_B;
wire A_eq_B;
comparator_4bit dut(A,B,A_gt_B,A_lt_B,A_eq_B);
initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0,comparator_4bit_tb);
    A=4'b0000; B=4'b0000; #10;
    A=4'b0101; B=4'b0011; #10;
    A=4'b0010; B=4'b0110; #10;
    A=4'b1111; B=4'b1111; #10;
    $finish;
end
endmodule
