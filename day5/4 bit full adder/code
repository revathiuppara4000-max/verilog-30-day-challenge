
module full_adder(
    input a,b,cin,
    output sum,cout
);
wire s1,c1,c2;
xor (s1,a,b);
xor (sum,s1,cin);
and (c1,a,b);
and (c2,s1,cin);
or  (cout,c1,c2);
endmodule
module four_bit_adder(
    input [3:0] A,
    input [3:0] B,
    input Cin,
    output [3:0] Sum,
    output Cout
);
wire c1,c2,c3;
full_adder FA0(A[0],B[0],Cin, Sum[0],c1);
full_adder FA1(A[1],B[1],c1,  Sum[1],c2);
full_adder FA2(A[2],B[2],c2,  Sum[2],c3);
full_adder FA3(A[3],B[3],c3,  Sum[3],Cout);
endmodule

