module barrel_shifter(
    input  [3:0] in,
    input  [1:0] n,
    input  lr,
    output reg [3:0] out
);
always @(*) begin
    if(lr == 1'b0)
        out = in << n;
    else
        out = in >> n;
end
endmodule

//testbench
`timescale 1ns/1ps
module barrel_shifter_tb;
reg [3:0] in;
reg [1:0] n;
reg lr;
wire [3:0] out;
