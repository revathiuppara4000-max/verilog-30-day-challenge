//---------------------
// Half Subtractor
//---------------------
module Half_Subtractor(
    input A,
    input B,
    output Diff,
    output Borrow
    );
    assign Diff   = A ^ B;
    assign Borrow = (~A) & B;

endmodule
//test bench
`timescale 1ns/1ps
module tb;
reg A,B;
wire Diff,Borrow;
Half_Subtractor dut(A,B,Diff,Borrow);
initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0,tb);
    $monitor("A=%b B=%b | Diff=%b Borrow=%b",A,B,Diff,Borrow);
    A=0; B=0; #10;
    A=0; B=1; #10;
    A=1; B=0; #10;
    A=1; B=1; #10;
    $finish;
end
endmodule
