module Full_Adder(
    input A,
    input B,
    input Cin,
    output Sum,
    output Carry
    );
    assign Sum = A ^ B ^ Cin;
    assign Carry = (A & B) | (Cin & (A ^ B));
endmodule

//testbench
`timescale 1ns/1ps
module tb;
reg A,B,Cin;
wire Sum,Carry;
Full_Adder dut(A,B,Cin,Sum,Carry);
initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0,tb);
    $monitor("A=%b B=%b Cin=%b | Sum=%b Carry=%b",A,B,Cin,Sum,Carry);
    A=0; B=0; Cin=0; #10;
    A=0; B=0; Cin=1; #10;
    A=0; B=1; Cin=0; #10;
    A=0; B=1; Cin=1; #10;
    A=1; B=0; Cin=0; #10;
    A=1; B=0; Cin=1; #10;
    A=1; B=1; Cin=0; #10;
    A=1; B=1; Cin=1; #10;
    $finish;
end
endmodule
