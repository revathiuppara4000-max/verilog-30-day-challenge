module sr_flipflop (
    input S,
    input R,
    output reg Q,
    output Qbar
);
assign Qbar = ~Q;
always @(S or R)
begin
    if (S == 1'b0 && R == 1'b0)
        Q = Q;
    else if (S == 1'b0 && R == 1'b1)
        Q = 1'b0;
    else if (S == 1'b1 && R == 1'b0)
        Q = 1'b1;
    else
        Q = 1'bx;
end

