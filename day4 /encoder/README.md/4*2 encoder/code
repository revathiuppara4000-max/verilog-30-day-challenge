module encoder4x2(
    input I0,
    input I1,
    input I2,
    input I3,
    output Y0,
    output Y1
);
assign Y1 = I2 | I3;
assign Y0 = I1 | I3;
endmodule

//testbench

`timescale 1ns/1ps
module encoder4x2_tb;
reg I0,I1,I2,I3;
wire Y0,Y1;
encoder4x2 dut(
    .I0(I0),
    .I1(I1),
    .I2(I2),
    .I3(I3),
    .Y0(Y0),
    .Y1(Y1)
);
initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0,encoder4x2_tb);
    I0=1; I1=0; I2=0; I3=0; #10;
    I0=0; I1=1; I2=0; I3=0; #10;
    I0=0; I1=0; I2=1; I3=0; #10;
    I0=0; I1=0; I2=0; I3=1; #10;
    $finish;
end
endmodule
