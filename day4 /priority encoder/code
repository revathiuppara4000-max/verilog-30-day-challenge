module priority_encoder4x2(
input I0,I1,I2,I3,
output reg Y0,Y1
);
always @(*) begin
    if(I3)      {Y1,Y0}=2'b11;
    else if(I2) {Y1,Y0}=2'b10;
    else if(I1) {Y1,Y0}=2'b01;
    else        {Y1,Y0}=2'b00;
end
endmodule

