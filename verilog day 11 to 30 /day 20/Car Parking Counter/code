module parking_counter(clk, reset, entry, exit, count, full);

input clk, reset;
input entry, exit;
output reg [3:0] count;
output reg full;

parameter MAX = 4'd10;

always @(posedge clk)
begin
    if(reset)
    begin
        count <= 0;
        full <= 0;
    end
    else
    begin
        if(entry && !exit && count < MAX)
            count <= count + 1;
        else if(exit && !entry && count > 0)
            count <= count - 1;

        if(count == MAX)
            full <= 1;
        else
            full <= 0;
    end
end

endmodule


