module door_bell(clk, reset, button, bell);

input clk, reset, button;
output reg bell;

reg [3:0] count;

always @(posedge clk)
begin
    if(reset)
    begin
        bell <= 0;
        count <= 0;
    end
    else
    begin
        if(button)
        begin
            bell <= 1;
            count <= 4'd10;
        end
        else if(count > 0)
        begin
            count <= count - 1;
            bell <= 1;
        end
        else
        begin
            bell <= 0;
        end
    end
end

endmodule

