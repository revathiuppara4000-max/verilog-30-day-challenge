module water_tank(clk, reset, low, high, motor);

input clk, reset;
input low, high;
output reg motor;

parameter OFF = 1'b0;
parameter ON  = 1'b1;

reg state;

always @(posedge clk)
begin
    if(reset)
    begin
        state <= OFF;
        motor <= 0;
    end
    else
    begin
        case(state)
            OFF:
            begin
                if(low == 1)
                begin
                    state <= ON;
                    motor <= 1;
                end
            end

            ON:
            begin
                if(high == 1)
                begin
                    state <= OFF;
                    motor <= 0;
                end
            end
        endcase
    end
end

endmodule

