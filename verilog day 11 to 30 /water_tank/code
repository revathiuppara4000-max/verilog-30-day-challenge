module tb;

reg clk;
reg reset;
reg low;
reg high;
wire motor;

water_tank uut(clk, reset, low, high, motor);

initial
begin
    clk = 0;
    forever #5 clk = ~clk;
end

initial
begin
    reset = 1;
    low = 0;
    high = 0;
    #10 reset = 0;

    #10 low = 1;
    #20 low = 0;

    #30 high = 1;
    #20 high = 0;

    #30 low = 1;
    #20 low = 0;

    #100 $finish;
end

initial
begin
    $dumpfile("dump.vcd");
    $dumpvars;
end

endmodule
