module water_tank(clk, reset, low, high, motor);

input clk, reset, low, high;
output reg motor;

reg state;

always @(posedge clk)
begin
    if(reset)
    begin
        motor <= 0;
        state <= 0;
    end
    else
    begin
        case(state)
            0:
            begin
                if(low)
                begin
                    motor <= 1;
                    state <= 1;
                end
            end

            1:
            begin
                if(high)
                begin
                    motor <= 0;
                    state <= 0;
                end
            end
        endcase
    end
end

endmodule


