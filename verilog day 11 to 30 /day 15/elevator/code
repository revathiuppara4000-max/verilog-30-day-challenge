module elevator(clk,reset,req,current_floor,up,down);

input clk;
input reset;
input [2:0] req;
output reg [1:0] current_floor;
output reg up;
output reg down;

always @(posedge clk or posedge reset)
begin
if(reset)
begin
current_floor <= 0;
up <= 0;
down <= 0;
end
else
begin
up <= 0;
down <= 0;

if(req[2] && current_floor < 2)
begin
current_floor <= current_floor + 1;
up <= 1;
end
else if(req[0] && current_floor > 0)
begin
current_floor <= current_floor - 1;
down <= 1;
end
else if(req[1])
begin
if(current_floor < 1)
begin
current_floor <= current_floor + 1;
up <= 1;
end
else if(current_floor > 1)
begin
current_floor <= current_floor - 1;
down <= 1;
end
end
end
end

