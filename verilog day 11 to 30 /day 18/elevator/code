module elevator(clk, reset, req, current_floor, dir);

input clk, reset;
input [2:0] req;
output reg [1:0] current_floor;
output reg dir;

always @(posedge clk)
begin
    if(reset)
    begin
        current_floor <= 0;
        dir <= 0;
    end
    else
    begin
        if(req[current_floor] == 1'b0)
        begin
            if(req > (1 << current_floor))
            begin
                current_floor <= current_floor + 1;
                dir <= 1;
            end
            else if(req < (1 << current_floor))
            begin
                current_floor <= current_floor - 1;
                dir <= 0;
            end
        end
    end
end
