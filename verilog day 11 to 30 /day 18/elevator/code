module tb;

reg clk;
reg reset;
reg [2:0] req;
wire [1:0] current_floor;
wire dir;

elevator u(clk, reset, req, current_floor, dir);

initial
begin
    clk = 0;
    forever #5 clk = ~clk;
end

initial
begin
    reset = 1;
    req = 3'b000;
    #10 reset = 0;

    #10 req = 3'b100;
    #50 req = 3'b001;
    #50 req = 3'b010;

    #100 $finish;
end

initial
