module tb;

reg clk;
reg reset;
reg sensor;
wire lid;

dustbin uut(clk, reset, sensor, lid);

initial
begin
    clk = 0;
    forever #5 clk = ~clk;
end

initial
begin
    reset = 1;
    sensor = 0;
    #10 reset = 0;

    #10 sensor = 1; #10 sensor = 0;

    #100 sensor = 1; #10 sensor = 0;

    #200 $finish;
end

initial
begin
    $dumpfile("dump.vcd");
    $dumpvars;
end

endmodule
