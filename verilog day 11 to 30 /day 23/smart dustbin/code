module dustbin(clk, reset, sensor, lid);

input clk, reset, sensor;
output reg lid;

reg [3:0] count;
reg state;

always @(posedge clk)
begin
    if(reset)
    begin
        lid <= 0;
        count <= 0;
        state <= 0;
    end
    else
    begin
        if(sensor)
        begin
            lid <= 1;
            count <= 4'd10;
            state <= 1;
        end
        else if(state)
        begin
            if(count > 0)
            begin
                count <= count - 1;
                lid <= 1;
            end
            else
            begin
                lid <= 0;
                state <= 0;
            end
        end
    end
end

endmodule

