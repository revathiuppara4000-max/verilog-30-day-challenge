module digital_door_lock(
input clk,
input reset,
input [3:0] pass_in,
input enter,
output reg unlock,
output reg alarm
);

parameter PASSWORD = 4'b1010;
reg [1:0] wrong;

always @(posedge clk or posedge reset)
begin
    if(reset)
    begin
        unlock <= 0;
        alarm <= 0;
        wrong <= 0;
    end
    else if(enter)
    begin
        if(pass_in == PASSWORD)
        begin
            unlock <= 1;
            alarm <= 0;
            wrong <= 0;
        end
        else
        begin
            unlock <= 0;
            wrong <= wrong + 1;
            if(wrong == 2)
                alarm <= 1;
        end
    end
end


