module digital_clock(clk, reset, sec, min, hr);
input clk, reset;
output reg [5:0] sec;
output reg [5:0] min;
output reg [4:0] hr;
always @(posedge clk or posedge reset)
begin
    if(reset)
    begin
        sec <= 0;
        min <= 0;
        hr  <= 0;
    end
    else
    begin
        sec <= sec + 1;
        if(sec == 59)
        begin
            sec <= 0;
            min <= min + 1;
            if(min == 59)
            begin
                min <= 0;
                hr <= hr + 1;
                if(hr == 23)
                    hr <= 0;
            end
        end
    end
end
endmodule

