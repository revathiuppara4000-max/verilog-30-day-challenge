module up_down_counter(clk,reset,mode,q);
input clk;
input reset;
input mode;
output [3:0] q;
reg [3:0] q;
always @(posedge clk)
begin
if(reset)
q = 0;
else if(mode)
q = q + 1;
else
q = q - 1;
end
endmodule

