module decoder2x4(
    input A,
    input B,
    output Y0,
    output Y1,
    output Y2,
    output Y3
);

assign Y0 = ~A & ~B;
assign Y1 = ~A & B;
assign Y2 = A & ~B;
assign Y3 = A & B;

endmodule

//tb
`timescale 1ns/1ps

module decoder2x4_tb;

reg A,B;
wire Y0,Y1,Y2,Y3;

decoder2x4 dut(
    .A(A),
    .B(B),
    .Y0(Y0),
    .Y1(Y1),
    .Y2(Y2),
    .Y3(Y3)
);

initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0,decoder2x4_tb);

    A=0; B=0; #10;
    A=0; B=1; #10;
    A=1; B=0; #10;
    A=1; B=1; #10;

    $finish;
end

endmodule
