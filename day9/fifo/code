module fifo(clk,rst,wr_en,rd_en,data_in,data_out,full,empty);
input clk,rst,wr_en,rd_en;
input [7:0] data_in;
output reg [7:0] data_out;
output full,empty;
reg [7:0] mem[7:0];
reg [2:0] wptr,rptr;
reg [3:0] count;
assign full = (count==8);
assign empty = (count==0);
always @(posedge clk or posedge rst)
begin
    if(rst)
    begin
        wptr<=0;
        rptr<=0;
        count<=0;
    end
    else
    begin
        if(wr_en && !full)
        begin
            mem[wptr] <= data_in;
            wptr <= wptr + 1;
            count <= count + 1;
        end     
        if(rd_en && !empty)
        begin
            data_out <= mem[rptr];
            rptr <= rptr + 1;
            count <= count - 1;
        end
    end
end
endmodule

