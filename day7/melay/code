module mealy_101(
input clk,
input rst,
input x,
output reg y
);
reg [1:0] state;
parameter S0=2'b00, S1=2'b01, S2=2'b10;
always @(posedge clk or posedge rst)
begin
if(rst)
state <= S0;
else
begin
case(state)
S0:
begin
if(x==1)
state <= S1;
else
state <= S0;
y <= 0;
end
S1:
begin
if(x==0)
state <= S2;
else
state <= S1;
y <= 0;
end
S2:
begin
if(x==1)
begin
state <= S1;
y <= 1;
end
else
begin
state <= S0;
y <= 0;
end
end
default: state <= S0;
endcase
end
end
endmodule


